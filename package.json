{
    "name": "frontend_admission",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "prisma generate && next build",
        "postinstall": "prisma generate",
        "start": "next start",
        "lint": "eslint",
        "test": "node --test --test-isolation=none tests/sprint1/*.test.cjs tests/sprint2/*.test.cjs tests/sprint3/*.test.cjs tests/sprint4/*.test.cjs",
        "test:contracts": "node --test --test-isolation=none tests/contracts/*.test.cjs",
        "test:e2e": "playwright test --config tests/e2e/playwright.config.cjs",
        "test:seed": "node tests/fixtures/seed.cjs",
        "test:db:setup": "node tests/fixtures/setup-db.cjs",
        "test:db": "node --test --test-isolation=none tests/database/*.test.cjs",
        "test:all": "node tests/run-all.cjs",
        "test:watch": "node tests/e2e/watch-run.cjs",
        "test:watch:local": "node tests/e2e/watch-run.cjs --local",
        "test:watch:cleanup": "node tests/e2e/cleanup-live.cjs"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.10.0",
        "@prisma/client": "7.8.0",
        "@supabase/ssr": "^0.12.7",
        "@supabase/supabase-js": "^2.116.0",
        "bcryptjs": "^3.0.3",
        "fuse.js": "^7.5.0",
        "jose": "^6.2.12",
        "lucide-react": "^1.47.0",
        "next": "16.3.5",
        "pg": "^8.23.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-icons": "^5.7.0",
        "sonner": "^2.0.8"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@tailwindcss/postcss": "^4",
        "@types/bcryptjs": "^3.0.0",
        "@types/node": "^20",
        "@types/pg": "^8.23.1",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "dotenv": "^18.0.4",
        "eslint": "^10.11.0",
        "eslint-config-next": "16.3.5",
        "jsdom": "^30.1.3",
        "prisma": "7.8.0",
        "tailwindcss": "^4",
        "typescript": "^5"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@prisma/client",
            "prisma"
        ]
    },
    "packageManager": "pnpm@11.0.9"
}
