# Server-only URLs. The score service's app.py defaults to port 8100.
API_APPLICATION_SCORE=http://127.0.0.1:8100
API_AI_ML=http://127.0.0.1:8000
# Must equal INTERNAL_API_KEY configured on backend AI. Never use NEXT_PUBLIC_ for secrets.
AI_INTERNAL_API_KEY=replace-with-backend-ai-internal-key
# JWT_ACCESSTOKEN on Next.js must equal JWT_ACCESSTOKEN/JWT_SECRET on backend score.
# Keep the existing JWT_ACCESSTOKEN and JWT_REFRESHTOKEN in .env; do not commit their values.

# Private Supabase Storage bucket, provisioned separately; do not make the bucket public.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_EVIDENCE_BUCKET=illustrative_images
